  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login menggunakan username dan password di body. Response token disimpan ke environment `access_token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "try {",
                  "  var json = pm.response.json();",
                  "  if (json && json.data && json.data.access_token) {",
                  "    pm.environment.set('access_token', json.data.access_token);",
                  "  }",
                  "  if (json && json.data && json.data.scope) {",
                  "    pm.environment.set('scope', json.data.scope);",
                  "  }",
                  "} catch (e) {",
                  "  console.log('Unable to parse login response', e);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
